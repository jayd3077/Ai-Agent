# Gemini API configuration
# Copy this file to .env, then replace the placeholder with your real key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Admin page credentials. Change both values before sharing the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Simulation timing. The agent receives a frozen 20-second telemetry window.
BUFFER_WINDOW_SECONDS=20
DECISION_INTERVAL_SECONDS=20
FEEDBACK_WINDOW_SECONDS=30

# Optional simulation size and agent thresholds
NUM_REGIONS=5
SERVERS_PER_REGION=3
CHIPSETS_PER_SERVER=4
TEMP_THRESHOLD_C=68
UTIL_IMBALANCE_THRESHOLD=0.35
MIN_NET_PROFIT=0.0

# Max /api/ask calls per minute per client IP (public endpoint, costs LLM tokens)
ASK_RATE_LIMIT_PER_MINUTE=6
